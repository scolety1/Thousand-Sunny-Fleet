{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tsf://fleet/control/task-completion-contract.schema.v2.json",
  "title": "TSF Task Completion Contract V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_version", "required_task", "required_task_sha256",
    "deliverable_profile", "result_contract_class", "admission_eligibility",
    "operator_confirmation_required", "non_admission_reason", "exact_next_action",
    "required_deliverables", "required_output_format",
    "required_evidence", "optional_deliverables", "partial_completion_allowed",
    "accepted_dispositions", "success_criteria", "fail_closed_conditions",
    "original_intent_identity_sha256", "scope_transformation_identity_sha256",
    "task_completion_contract_identity_sha256"
  ],
  "properties": {
    "schema_version": { "const": "tsf_task_completion_contract_v2" },
    "contract_version": { "const": "TASK_COMPLETION_CONTRACT_V2" },
    "required_task": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "required_task_sha256": { "$ref": "#/$defs/sha256" },
    "deliverable_profile": { "enum": ["TEXT_RESPONSE_V2", "STRUCTURED_ANALYSIS_V2"] },
    "result_contract_class": { "enum": ["STRUCTURAL_TEXT_ONLY", "STRUCTURED_DETERMINISTIC"] },
    "admission_eligibility": { "enum": ["INFORMATIONAL_NON_ADMISSIBLE", "ADMISSIBLE_WHEN_VERIFIED"] },
    "operator_confirmation_required": { "type": "boolean" },
    "non_admission_reason": { "enum": ["GENERIC_TEXT_REQUIRES_PROSE_INTERPRETATION", null] },
    "exact_next_action": { "type": "string", "minLength": 1, "maxLength": 500 },
    "required_deliverables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deliverable_id", "description", "deliverable_type",
          "minimum_cardinality", "maximum_cardinality", "structure_rule",
          "content_path", "evidence_references_required"
        ],
        "properties": {
          "deliverable_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 },
          "deliverable_type": { "enum": ["STRING", "STRING_ARRAY"] },
          "minimum_cardinality": { "type": "integer", "minimum": 1, "maximum": 20 },
          "maximum_cardinality": { "type": "integer", "minimum": 1, "maximum": 20 },
          "structure_rule": { "enum": ["NONEMPTY_SUBSTANTIVE_TEXT_V2", "NONEMPTY_TEXT_V2", "BOUNDED_NONEMPTY_STRING_ARRAY_V2"] },
          "content_path": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
          "evidence_references_required": { "type": "boolean" }
        }
      }
    },
    "required_output_format": { "const": "TSF_GENERAL_RESULT_V2_JSON" },
    "required_evidence": { "$ref": "#/$defs/nonEmptyStringArray" },
    "optional_deliverables": { "$ref": "#/$defs/stringArray" },
    "partial_completion_allowed": { "type": "boolean" },
    "accepted_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["FULFILLED", "FULFILLED_WITH_CAVEATS", "PARTIAL"] },
      "uniqueItems": true
    },
    "success_criteria": { "$ref": "#/$defs/nonEmptyStringArray" },
    "fail_closed_conditions": { "$ref": "#/$defs/nonEmptyStringArray" },
    "original_intent_identity_sha256": { "$ref": "#/$defs/sha256" },
    "scope_transformation_identity_sha256": { "$ref": "#/$defs/sha256" },
    "task_completion_contract_identity_sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "deliverable_profile": { "const": "TEXT_RESPONSE_V2" } } },
      "then": {
        "properties": {
          "result_contract_class": { "const": "STRUCTURAL_TEXT_ONLY" },
          "admission_eligibility": { "const": "INFORMATIONAL_NON_ADMISSIBLE" },
          "operator_confirmation_required": { "const": true },
          "non_admission_reason": { "const": "GENERIC_TEXT_REQUIRES_PROSE_INTERPRETATION" }
        }
      }
    },
    {
      "if": { "properties": { "deliverable_profile": { "const": "STRUCTURED_ANALYSIS_V2" } } },
      "then": {
        "properties": {
          "result_contract_class": { "const": "STRUCTURED_DETERMINISTIC" },
          "admission_eligibility": { "const": "ADMISSIBLE_WHEN_VERIFIED" },
          "operator_confirmation_required": { "const": false },
          "non_admission_reason": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "nonEmptyStringArray": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
